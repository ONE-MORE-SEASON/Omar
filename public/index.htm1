<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digital Clock - Multiple Time Zones</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            border: 1px solid rgba(255, 255, 255, 0.18);
            max-width: 900px;
            width: 100%;
        }

        h1 {
            text-align: center;
            color: white;
            margin-bottom: 40px;
            font-size: 2.5em;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .clocks-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .clock-card {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 15px;
            padding: 25px;
            text-align: center;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .clock-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
        }

        .timezone-name {
            color: #fff;
            font-size: 1.1em;
            font-weight: bold;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .time-display {
            font-size: 2.5em;
            font-weight: bold;
            color: #00ff88;
            font-family: 'Courier New', monospace;
            margin-bottom: 10px;
            text-shadow: 0 0 10px rgba(0, 255, 136, 0.5);
        }

        .date-display {
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.9em;
        }

        .add-timezone {
            margin-top: 30px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 10px;
        }

        .add-timezone h3 {
            color: white;
            margin-bottom: 15px;
        }

        .timezone-input-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        input, select, button {
            padding: 10px 15px;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        input, select {
            background: rgba(255, 255, 255, 0.9);
            color: #333;
            flex: 1;
            min-width: 150px;
        }

        button {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            font-weight: bold;
            min-width: 100px;
        }

        button:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        @media (max-width: 600px) {
            h1 {
                font-size: 1.8em;
            }

            .time-display {
                font-size: 2em;
            }

            .container {
                padding: 20px;
            }

            .timezone-input-group {
                flex-direction: column;
            }

            input, select, button {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🌍 Global Digital Clock</h1>
        
        <div class="clocks-grid" id="clocksContainer">
            <!-- Clocks will be added here dynamically -->
        </div>

        <div class="add-timezone">
            <h3>Add New Time Zone</h3>
            <div class="timezone-input-group">
                <input 
                    type="text" 
                    id="timezoneName" 
                    placeholder="e.g., New York, London, Tokyo"
                >
                <select id="timezoneOffset">
                    <option value="">Select Timezone Offset</option>
                    <option value="-12">UTC-12</option>
                    <option value="-11">UTC-11</option>
                    <option value="-10">UTC-10</option>
                    <option value="-9">UTC-9</option>
                    <option value="-8">UTC-8 (PST)</option>
                    <option value="-7">UTC-7 (MST)</option>
                    <option value="-6">UTC-6 (CST)</option>
                    <option value="-5">UTC-5 (EST)</option>
                    <option value="-4">UTC-4</option>
                    <option value="-3">UTC-3</option>
                    <option value="-2">UTC-2</option>
                    <option value="-1">UTC-1</option>
                    <option value="0">UTC (London)</option>
                    <option value="1">UTC+1 (Paris, Berlin)</option>
                    <option value="2">UTC+2 (Cairo)</option>
                    <option value="3">UTC+3 (Moscow)</option>
                    <option value="4">UTC+4</option>
                    <option value="5">UTC+5 (Pakistan)</option>
                    <option value="5.5">UTC+5:30 (India)</option>
                    <option value="6">UTC+6</option>
                    <option value="7">UTC+7 (Bangkok)</option>
                    <option value="8">UTC+8 (Hong Kong, Singapore)</option>
                    <option value="9">UTC+9 (Tokyo)</option>
                    <option value="10">UTC+10 (Sydney)</option>
                    <option value="11">UTC+11</option>
                    <option value="12">UTC+12 (New Zealand)</option>
                </select>
                <button onclick="addTimezone()">Add</button>
            </div>
        </div>
    </div>

    <script>
        // Default time zones
        const defaultTimezones = [
            { name: 'New York (EST)', offset: -5 },
            { name: 'London (GMT)', offset: 0 },
            { name: 'Tokyo (JST)', offset: 9 },
            { name: 'Sydney (AEDT)', offset: 11 }
        ];

        let timezones = JSON.parse(localStorage.getItem('timezones')) || defaultTimezones;

        function getTimeInTimezone(offset) {
            const now = new Date();
            const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
            const tzTime = new Date(utc + (3600000 * offset));
            return tzTime;
        }

        function formatTime(date) {
            return date.toLocaleTimeString('en-US', { 
                hour: '2-digit', 
                minute: '2-digit', 
                second: '2-digit',
                hour12: true 
            });
        }

        function formatDate(date) {
            return date.toLocaleDateString('en-US', { 
                weekday: 'short', 
                year: 'numeric', 
                month: 'short', 
                day: 'numeric' 
            });
        }

        function updateClocks() {
            const container = document.getElementById('clocksContainer');
            container.innerHTML = '';

            timezones.forEach((tz, index) => {
                const time = getTimeInTimezone(tz.offset);
                const card = document.createElement('div');
                card.className = 'clock-card';
                card.innerHTML = `
                    <div class="timezone-name">${tz.name}</div>
                    <div class="time-display">${formatTime(time)}</div>
                    <div class="date-display">${formatDate(time)}</div>
                    <button onclick="removeTimezone(${index})" style="margin-top: 10px; width: 100%; background: #ff6b6b;">Remove</button>
                `;
                container.appendChild(card);
            });
        }

        function addTimezone() {
            const name = document.getElementById('timezoneName').value.trim();
            const offset = parseFloat(document.getElementById('timezoneOffset').value);

            if (!name || document.getElementById('timezoneOffset').value === '') {
                alert('Please fill in both fields');
                return;
            }

            timezones.push({ name, offset });
            localStorage.setItem('timezones', JSON.stringify(timezones));
            
            document.getElementById('timezoneName').value = '';
            document.getElementById('timezoneOffset').value = '';
            
            updateClocks();
        }

        function removeTimezone(index) {
            timezones.splice(index, 1);
            localStorage.setItem('timezones', JSON.stringify(timezones));
            updateClocks();
        }

        // Update clocks every second
        updateClocks();
        setInterval(updateClocks, 1000);

        // Allow Enter key to add timezone
        document.getElementById('timezoneName').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') addTimezone();
        });
    </script>
</body>
</html>